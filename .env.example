# Sakuci Hosting Configuration File
# Copy this file to .env and update values

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=sakuci_hosting
DB_PORT=3306

# Application
APP_NAME="Sakuci Hosting"
APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost/hosting

# Company
COMPANY_NAME="Sakuci Hosting"
COMPANY_EMAIL=support@sakuci-hosting.com
COMPANY_PHONE=+62-XXX-XXX-XXXX
COMPANY_ADDRESS="Indonesia"

# Currency
CURRENCY=IDR
TAX_RATE=10

# Security
ENABLE_SSL=false
SESSION_TIMEOUT=3600
PASSWORD_MIN_LENGTH=8

# Email Configuration (Optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM=support@sakuci-hosting.com

# Payment Gateway (Optional)
PAYMENT_GATEWAY=stripe
STRIPE_PUBLIC_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx

# API
API_ENABLED=true
API_RATE_LIMIT=1000
API_TIMEOUT=30

# Logging
LOG_LEVEL=info
LOG_PATH=logs/

# Server
MAX_UPLOAD_SIZE=100M
MAX_EXECUTION_TIME=300
MEMORY_LIMIT=256M
