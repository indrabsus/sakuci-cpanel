<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Blokir semua berkas dan folder berawalan titik -- terutama .git, yang
    # bila terbuka memungkinkan seluruh repositori beserta riwayat commit
    # diunduh utuh. Pengecualian .well-known wajib ada, dipakai Let's Encrypt
    # untuk memperpanjang sertifikat SSL.
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule (^|/)\. - [F,L]

    # Folder yang tidak boleh dilayani langsung.
    #
    # projects/ diblokir DI SINI, bukan lewat .htaccess di dalamnya. Vhost
    # wildcard menyajikan projects/<nama>/public sebagai DocumentRoot-nya
    # sendiri, dan berkas ini berada di atas DocumentRoot itu sehingga tidak
    # ikut terbaca -- persis yang diinginkan: tertutup lewat domain panel,
    # terbuka lewat subdomain siswa.
    RewriteRule ^(config|database|tools|logs|projects)/ - [F,L]

    # Dokumentasi dan dump SQL tidak perlu terbuka ke publik.
    RewriteRule \.(md|sql)$ - [F,L]
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Catatan: pengaturan display_errors TIDAK ditaruh di sini. php_flag hanya
# berlaku untuk mod_php, sedangkan aaPanel menjalankan PHP-FPM sehingga
# blok semacam itu diabaikan diam-diam. Pengaturannya ada di config/config.php,
# dikendalikan lewat 'debug' di config/env.php.

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css A2592000
    ExpiresByType application/javascript A2592000
</IfModule>
